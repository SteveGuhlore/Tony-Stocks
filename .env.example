# Copy this file to .env and fill in real values locally.
# Never commit .env or real API keys.

POLYGON_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
FINNHUB_API_KEY=
FMP_API_KEY=
TWELVE_DATA_API_KEY=

# LLM narrator for the nightly self-learning loop (optional — without a key the loop
# still runs and falls back to deterministic templates). Set the one matching your SDK:
#   GEMINI_API_KEY  -> uses google-genai (gemini-2.0-flash by default)
#   GOOGLE_API_KEY  -> accepted as an alias for GEMINI_API_KEY
#   ANTHROPIC_API_KEY -> uses anthropic (claude-sonnet-4-6) instead
# Provider is auto-detected (config learning.provider: auto).
GEMINI_API_KEY=

# V1 does not place real orders. Keep this false.
LIVE_TRADING_ENABLED=false
