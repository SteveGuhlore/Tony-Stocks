[Unit]
Description=Trading Bot — live scan/track/paper-trade watch loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=/opt/trading-bot
EnvironmentFile=/opt/trading-bot/.env
Environment=PYTHONPATH=src
# run_watch loops forever (max_cycles unlimited), scans every interval_minutes,
# self-gates on market hours, honors data/STOP_WATCH_MODE. Places the bot's OWN
# paper entries when paper_trading.enabled=true (its own Alpaca account, != CC).
ExecStart=/opt/trading-bot/.venv/bin/python -m trading_bot.cli watch --config config/default_config.yaml
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
