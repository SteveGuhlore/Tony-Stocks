[Unit]
Description=Command Center — agent task runner loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=/opt/command-center
EnvironmentFile=/opt/command-center/.env
ExecStart=/opt/command-center/.venv/bin/python -m runner.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
