[Unit]
Description=Command Center — dashboard (FastAPI, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=/opt/command-center
EnvironmentFile=/opt/command-center/.env
ExecStart=/opt/command-center/.venv/bin/python -m uvicorn dashboard.server:app --host 127.0.0.1 --port 8765
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
