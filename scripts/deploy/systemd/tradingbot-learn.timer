[Unit]
Description=Nightly trigger for tradingbot-learn (01:30 America/New_York)

[Timer]
# 01:30 ET nightly — before the Command Center's 2am evolve, same as the old local task.
OnCalendar=*-*-* 01:30:00 America/New_York
# If the VM was asleep/off at 01:30, run as soon as it's back up.
Persistent=true

[Install]
WantedBy=timers.target
