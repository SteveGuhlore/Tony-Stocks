# trading-bot .env — copy to /opt/trading-bot/.env on the VM, then `chmod 600`.
# NEVER commit a filled-in copy. EnvironmentFile= in the systemd units reads this.

PYTHONPATH=src

# --- Alpaca (BOT's OWN paper account) ---
# SAFETY: this MUST be a different paper account than the Command Center / Tony uses.
# Never share Alpaca keys between the bot and the CC.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# (Optional dedicated bot paper account, if you separate them by name:)
# ALPACA_PAPER_API_KEY=
# ALPACA_PAPER_SECRET=

# --- Research data providers ---
FMP_API_KEY=
FINNHUB_API_KEY=

# --- Vertex AI (Gemini for the narrator; decision-free, fail-quiet) ---
# The bot's google-genai adapter switches to Vertex when this flag is truthy and a
# project is set; otherwise it falls back to GEMINI_API_KEY, then to deterministic
# templates. learning.provider auto-resolves to "gemini".
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/opt/secrets/vertex-key.json
# Alternative (free AI Studio key) instead of Vertex — leave the flag false to use it:
# GEMINI_API_KEY=

# --- Dashboard control plane (api/routes/controls.py) ---
# ENV_ROLE=prod is what ENABLES money-adjacent controls (flatten-all, etc.) via the
# env fence. IMPORTANT: when ENV_ROLE=prod a PIN is now REQUIRED — DASHBOARD_ACTION_PIN
# must be set or every control action returns HTTP 403 (fail-closed). The dashboard UI
# prompts for this PIN and sends it. Leave ENV_ROLE unset on a non-prod box.
# ENV_ROLE=prod
# DASHBOARD_ACTION_PIN=
# Optional: browser-origin allowlist for control POSTs (defaults to localhost:3000).
# CORS_ORIGINS=https://your-dashboard-host
